[Unit]
Description=Doorbell and Gate Automation Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=greg
WorkingDirectory=/home/greg/Brama
ExecStart=/home/greg/Brama/venv/bin/python /home/greg/Brama/doorbell/main.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target